# Read by Docker Compose. Copy to .env to override.
APP_HOST_PORT=3000
REDIS_HOST_PORT=6390
LOG_LEVEL=info
# Test override only: host port for the Monobank mock, bound to 127.0.0.1.
MONOBANK_MOCK_HOST_PORT=8081

# Application variables. Compose sets PORT, NODE_ENV and REDIS_URL for the app container with
# the values below; the Monobank and cache variables take their defaults (the test override
# points MONOBANK_BASE_URL at the mock and sets RATES_CACHE_TTL_SECONDS to 5). Export them only
# when running the backend outside Compose.
PORT=3000
NODE_ENV=production
REDIS_URL=redis://redis:6379
MONOBANK_BASE_URL=https://api.monobank.ua
MONOBANK_TIMEOUT_MS=3000
RATES_CACHE_TTL_SECONDS=300
