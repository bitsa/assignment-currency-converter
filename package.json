{
  "name": "currency-converter",
  "version": "0.1.0",
  "private": true,
  "description": "Currency converter backed by Monobank exchange rates with a Redis cache-aside layer",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "backend",
    "frontend",
    "tools/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
