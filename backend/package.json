{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Currency converter HTTP API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.json --runInBand",
    "test:integration:ci": "jest --config jest.integration.config.json --runInBand --testPathIgnorePatterns /node_modules/ /dist/ stack-lifecycle"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "decimal.js": "^10.6.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.9",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12"
  }
}
