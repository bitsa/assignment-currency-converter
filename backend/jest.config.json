{
  "roots": ["<rootDir>/src"],
  "testRegex": "\\.spec\\.ts$",
  "testEnvironment": "node",
  "moduleFileExtensions": ["ts", "js", "json"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.spec.ts", "!src/testing/**", "!src/main.ts"],
  "coverageDirectory": "coverage"
}
